<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Poppins:wght@600;700&display=swap" />
  {# Compiled Tailwind stylesheet from meco-front/dist, injected by render.py #}
  <style>{{ css }}</style>
  <style>
    html, body { margin: 0; background: #fff; }
    #card-wrap { width: {{ width }}px; }
  </style>
</head>
<body class="font-body text-body-sm text-txt-black-900"
      style="font-family: Inter, sans-serif; --font-poppins: Poppins, sans-serif;">
  <div id="card-wrap">
    <div id="card" class="relative flex w-full flex-col overflow-hidden rounded-2xl bg-bg-white shadow-xl">

      {# ---- Header (ported from SeatElectionTable.tsx modal header) ---- #}
      <div class="flex flex-col gap-3 px-4 pb-2 pt-4 uppercase">
        <div class="flex w-full items-start justify-between gap-2">
          <div class="flex min-w-0 flex-1 flex-col gap-3">
            <div class="flex flex-wrap items-baseline gap-x-1.5 text-body-md">
              <span class="font-semibold">{{ card.election_display }}</span>
              <span class="text-txt-black-500" aria-hidden="true">&middot;</span>
              <span class="text-txt-black-500">{{ card.date_str }}</span>
            </div>
            <div class="flex flex-wrap items-baseline gap-x-2 text-body-md">
              <span class="font-semibold">{{ card.seat }}{% if card.state %},{% endif %}</span>
              {% if card.state %}<span class="font-normal text-txt-black-500">{{ card.state }}</span>{% endif %}
            </div>
          </div>
          {# Brand (top-right): electiondata.my logo + site title #}
          <div class="flex shrink-0 items-center gap-1.5" style="text-transform: none;">
            {% if brand_logo %}<img src="{{ brand_logo }}" alt="ElectionData.MY Logo" width="24" height="24" class="aspect-auto select-none object-contain" />{% endif %}
            <span class="font-poppins text-body-md font-bold text-txt-black-900">ElectionData.MY</span>
          </div>
        </div>
      </div>

      {# ---- Body ---- #}
      <div class="space-y-6 px-4 pb-8 pt-2 text-body-md">

        {# Ballot table — full-bleed (-16px each side) so dividers and the winner
           highlight span the full card width; edge cells re-pad with pl-4/pr-4. #}
        <div style="margin-left: -1rem; margin-right: -1rem;">
          <table class="w-full table-fixed text-body-sm">
            <colgroup>
              <col class="w-[43%]" />
              <col class="w-[26%]" />
              <col class="w-[31%]" />
            </colgroup>
            <thead>
              <tr class="border-b-2 border-otl-gray-200 font-medium">
                <th class="py-3 pl-4 pr-3 text-left">Candidate Name</th>
                <th class="px-3 py-3 text-center sm:text-left">Party</th>
                <th class="py-3 pl-3 pr-4 text-left">Votes Won</th>
              </tr>
            </thead>
            <tbody>
              {% for e in card.candidates %}
              {% set winbg = "background-color: rgb(var(--bg-success-100));" if e.is_winner else "" %}
              <tr class="border-b border-otl-gray-200">
                <td class="min-w-0 break-words py-3 pl-4 pr-3 text-left" style="overflow-wrap: anywhere; white-space: normal; {{ winbg }}">{{ e.name }}</td>
                <td class="px-3 py-3" style="{{ winbg }}">
                  <div class="flex flex-col items-center gap-1 whitespace-nowrap sm:flex-row sm:items-center sm:gap-1.5">
                    <div class="relative flex h-4 w-8 shrink-0 items-center justify-center outline outline-1 outline-otl-gray-200 text-xs text-txt-black-400">
                      {% if e.logo_uri %}<img src="{{ e.logo_uri }}" alt="{{ e.party_display }}" class="absolute inset-0 h-full w-full object-contain" />{% else %}?{% endif %}
                    </div>
                    <span class="whitespace-nowrap text-center text-xs sm:text-left sm:text-body-sm">{{ e.party_display }}</span>
                  </div>
                </td>
                <td class="py-3 pl-3 pr-4 sm:font-['IBM_Plex_Mono','Roboto_Mono',monospace] sm:tabular-nums" style="{{ winbg }}">
                  <div class="flex flex-col gap-2 whitespace-nowrap sm:flex-row sm:items-center sm:gap-0.5">
                    <div class="h-[5px] w-[80px] shrink-0 overflow-x-hidden rounded-full bg-bg-washed sm:w-[72px]">
                      <div class="h-full overflow-hidden rounded-full bg-bg-black-900" style="width: {{ e.bar_width }};"></div>
                    </div>
                    <span class="whitespace-nowrap text-xs sm:text-body-sm">
                      <span class="sm:inline-block sm:min-w-[3.75rem] sm:text-right">{{ e.votes_str }}</span>
                      <span> ({{ e.votes_perc_str }})</span>
                    </span>
                  </div>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        {# Summary statistics #}
        {% if card.stats %}
        <div class="pt-8">
          <p class="font-bold">Summary Statistics</p>
          <div class="flex flex-col gap-5 text-sm" style="margin-top: 1rem;">
            {% for st in card.stats %}
            <div class="flex w-[245px] flex-col gap-2 whitespace-nowrap">
              <div class="flex items-center justify-between gap-3 text-body-sm text-txt-black-500">
                <span class="w-28 md:w-fit">{{ st.label }}:</span>
                <span class="text-txt-black-700">{{ st.text }}</span>
              </div>
              {% if st.show_bar %}
              <div class="h-[5px] w-[245px] overflow-x-hidden rounded-full bg-bg-washed">
                <div class="h-full overflow-hidden rounded-full bg-bg-black-900" style="width: {{ st.bar_width }};"></div>
              </div>
              {% endif %}
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>
    </div>
  </div>
</body>
</html>
